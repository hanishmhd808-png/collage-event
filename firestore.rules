rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'organizer' ||
        request.auth.token.role == 'teacher'
      );
    }

    // Events collection: Publicly readable; writable by authenticated staff or event organizers
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isStaffOrAdmin();
    }

    // Registrations collection: Readable by owner or staff; creatable by registered student
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid ||
        isStaffOrAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.studentUid.size() > 0
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid ||
        isStaffOrAdmin()
      );
    }

    // Groups collection: Readable by authenticated users; manageable by members or staff
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.leaderUid == request.auth.uid ||
        (resource.data.members is list && request.auth.uid in resource.data.members) ||
        isStaffOrAdmin()
      );
    }

    // Users profile collection: Readable by authenticated users; editable only by profile owner
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isStaffOrAdmin();
    }

    // Certificates collection: Publicly readable for verification; writable by teachers or admins
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAuthenticated() || isStaffOrAdmin();
    }

    // Notifications collection: Private to each user
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
    }

    // System activities & metadata
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAuthenticated() || isStaffOrAdmin();
    }
  }
}
